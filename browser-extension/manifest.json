{
  "manifest_version": 3,
  "name": "Applier Keep Going",
  "version": "1.1.0",
  "description": "Sends a continuation message when your Applier Dot has been inactive for too long.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Applier Keep Going"
  }
}
